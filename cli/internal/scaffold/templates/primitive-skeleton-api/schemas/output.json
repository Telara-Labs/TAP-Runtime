{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["REPLACE_TOP_LEVEL_FIELD"],
  "properties": {
    "REPLACE_TOP_LEVEL_FIELD": {
      "type": "array",
      "description": "REPLACE — note documented empty-list cases here",
      "items": {
        "type": "object",
        "required": ["REPLACE_REQUIRED_ITEM_FIELD", "classified_by"],
        "properties": {
          "REPLACE_REQUIRED_ITEM_FIELD": {"type": "string"},
          "category": {"enum": ["REPLACE", "unknown"]},
          "evidence": {"type": "string", "description": "Matched signature name, or reasoning evidence"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "classified_by": {"enum": ["signature", "reasoning", "gate_demotion"]}
        }
      }
    }
  }
}
