{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["entries", "source", "extraction"],
  "properties": {
    "entries": {
      "type": "array",
      "description": "REPLACE sort order and empty-case note",
      "items": {
        "type": "object",
        "required": ["title", "extracted_by"],
        "properties": {
          "title": {"type": "string"},
          "date": {"type": ["string", "null"], "format": "date"},
          "url": {"type": ["string", "null"], "format": "uri"},
          "extracted_by": {"enum": ["cached_selectors", "reasoning_fallback"]}
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "checked_entries": {"type": "integer"}
      }
    },
    "extraction": {
      "type": "object",
      "required": ["mode", "drift_detected"],
      "properties": {
        "mode": {"enum": ["cached_selectors", "reasoning_fallback"]},
        "drift_detected": {"type": "boolean"},
        "drift_reason": {"type": ["string", "null"]},
        "repair_proposed": {"type": "boolean"}
      }
    }
  }
}
