package testrunner

import (
	"os"
	"path/filepath"
	"testing"

	"telara.dev/tap/internal/model"
)

// examplesDir locates the two hand-authored example packages that live
// alongside this module in the telara-documentation repo (sibling checkout
// under .../Telara/telara-documentation). Tests skip gracefully if that
// checkout isn't present (e.g. a bare clone of telara-tap on its own).
func examplesDir(t *testing.T) string {
	t.Helper()
	dir := filepath.Join("..", "..", "..", "..", "telara-documentation", "architecture", "tap", "examples")
	abs, err := filepath.Abs(dir)
	if err != nil {
		t.Skip("cannot resolve examples dir")
	}
	if _, err := os.Stat(abs); err != nil {
		t.Skipf("examples checkout not found at %s: %v", abs, err)
	}
	return abs
}

func TestGolden_GitlabPipelineTriage(t *testing.T) {
	dir := filepath.Join(examplesDir(t), "gitlab-pipeline-triage")
	pkg, err := model.LoadPackage(dir)
	if err != nil {
		t.Fatalf("LoadPackage: %v", err)
	}
	report, err := Run(pkg, Options{})
	if err != nil {
		t.Fatalf("Run: %v", err)
	}
	if len(report.Cases) == 0 {
		t.Fatalf("no cases ran")
	}
	for _, c := range report.Cases {
		if !c.Passed {
			t.Errorf("case %q failed: %v", c.Name, c.Failures)
		}
	}
}

func TestGolden_WebChangelogWatch(t *testing.T) {
	dir := filepath.Join(examplesDir(t), "web-changelog-watch")
	pkg, err := model.LoadPackage(dir)
	if err != nil {
		t.Fatalf("LoadPackage: %v", err)
	}
	report, err := Run(pkg, Options{Binds: map[string]string{"watched_site": "https://docs.example.dev"}})
	if err != nil {
		t.Fatalf("Run: %v", err)
	}
	if len(report.Cases) == 0 {
		t.Fatalf("no cases ran")
	}
	for _, c := range report.Cases {
		if !c.Passed {
			t.Errorf("case %q failed: %v", c.Name, c.Failures)
		}
	}
}
