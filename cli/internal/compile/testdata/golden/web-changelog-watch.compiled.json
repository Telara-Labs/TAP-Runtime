{
  "name": "dev.telara/web-changelog-watch",
  "description": "Watch a product changelog or release-notes web page and return its entries as structured records (version, date, title, highlights, url), newest first, optionally filtered to entries after a given date. Works on public JS-rendered pages with no API. Read-only; navigates and reads within the bound origin only — never clicks through to other sites, submits forms, or downloads files.",
  "entry_node_id": "page",
  "nodes": [
    {
      "id": "page",
      "name": "page",
      "type": "tool",
      "input_bindings": [
        {
          "name": "url",
          "target_path": "url",
          "source_expression": "trigger.url",
          "required": true
        }
      ],
      "tool": {
        "integration_type": "browser",
        "tool_name": "extract",
        "static_parameters": {
          "on_drift": "capture_text",
          "origin": {
            "slot": "watched_site"
          },
          "plan": {
            "drift_detection": [
              {
                "root_selector_matches": 0
              },
              {
                "required_field_missing_pct": 20
              },
              {
                "unexpected_navigation": true
              },
              {
                "anti_bot_interstitial": true
              },
              {
                "dom_shape_hash_delta": 0.35
              }
            ],
            "entries": {
              "fields": {
                "date": {
                  "attr": "datetime | text",
                  "parse": "date",
                  "selector": "time"
                },
                "highlights": {
                  "attr": "text",
                  "list": true,
                  "max": 8,
                  "selector": "ul li"
                },
                "title": {
                  "attr": "text",
                  "required": true,
                  "selector": "h2, h3, [role='heading']"
                },
                "url": {
                  "attr": "href",
                  "resolve": "absolute",
                  "selector": "a[href]"
                },
                "version": {
                  "attr": "text",
                  "selector": "h2 code, .version, [class*='version']"
                }
              },
              "item": "article, section:has(h2), li:has(time)",
              "root": "main [role='feed'], main section:has(h2), main article"
            },
            "on_drift": {
              "capture": "readability_text",
              "emit": "drift_event",
              "max_capture_chars": 20000
            },
            "ready": {
              "network_idle_ms": 800,
              "timeout_ms": 15000,
              "wait_for": "main"
            },
            "version_signals": [
              "meta[name=\"generator\"]",
              "link[rel=\"stylesheet\"]@count"
            ]
          }
        }
      },
      "retry_policy": {
        "max_attempts": 2,
        "initial_backoff_seconds": 3,
        "retry_on": [
          "timeout",
          "navigation"
        ]
      },
      "effect_class": "read",
      "metadata": {
        "origin_slot": "watched_site",
        "session": "none"
      }
    },
    {
      "id": "extract_fallback",
      "name": "extract_fallback",
      "type": "model",
      "input_bindings": [
        {
          "name": "input",
          "target_path": "input",
          "source_expression": "nodes.page.result.page_text"
        }
      ],
      "model": {
        "prompt": "Perform the workflow reasoning task: extract_changelog_entries_from_page_text",
        "task": "extract_changelog_entries_from_page_text",
        "output_schema": {
          "items": {
            "properties": {
              "date": {
                "format": "date",
                "type": [
                  "string",
                  "null"
                ]
              },
              "highlights": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "format": "uri",
                "type": [
                  "string",
                  "null"
                ]
              },
              "version": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "title"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "max_iterations": 1,
        "routing_profile": "structured-output",
        "lease_config_json": "{\"capabilities\":[\"structured-output\"],\"data_classes\":[\"public-web-content\"],\"input_schema\":{\"type\":\"string\"},\"max_tokens\":1500,\"output_schema\":{\"items\":{\"properties\":{\"date\":{\"format\":\"date\",\"type\":[\"string\",\"null\"]},\"highlights\":{\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"title\":{\"type\":\"string\"},\"url\":{\"format\":\"uri\",\"type\":[\"string\",\"null\"]},\"version\":{\"type\":[\"string\",\"null\"]}},\"required\":[\"title\"],\"type\":\"object\"},\"type\":\"array\"}}"
      },
      "effect_class": "read"
    },
    {
      "id": "extract_fallback__gate",
      "name": "extract_fallback gate",
      "type": "branch",
      "branch": {
        "condition_expression": "nodes.page.result.drift == true",
        "default_node_id": "extract_fallback__skip"
      },
      "metadata": {
        "gated_step": "extract_fallback",
        "when": "steps.page.drift == true"
      }
    },
    {
      "id": "extract_fallback__skip",
      "name": "extract_fallback skipped",
      "type": "noop",
      "metadata": {
        "bypass_of": "extract_fallback"
      }
    },
    {
      "id": "normalize",
      "name": "normalize",
      "type": "transform",
      "input_bindings": [
        {
          "name": "cached",
          "target_path": "cached",
          "source_expression": "nodes.page.result.entries_raw"
        },
        {
          "name": "cap",
          "target_path": "cap",
          "source_expression": "trigger.max_entries"
        },
        {
          "name": "drift",
          "target_path": "drift",
          "source_expression": "nodes.page.result.drift"
        },
        {
          "name": "drift_reason",
          "target_path": "drift_reason",
          "source_expression": "nodes.page.result.drift_reason"
        },
        {
          "name": "page_url",
          "target_path": "page_url",
          "source_expression": "trigger.url"
        },
        {
          "name": "reasoned",
          "target_path": "reasoned",
          "source_expression": "nodes.extract_fallback.result"
        },
        {
          "name": "since",
          "target_path": "since",
          "source_expression": "trigger.since"
        }
      ],
      "transform": {
        "language": "starlark",
        "program": "# normalize.star — merge cached/reasoned extractions, filter, sort, stamp provenance.\n# Predeclared params: cached, reasoned, drift, drift_reason, since, cap, page_url.\n# Output via `result`. Pure transform: zero builtins, no I/O possible.\n\ndef _valid_date(d):\n    # Starlark has no datetime; accept ISO yyyy-mm-dd prefix, else None.\n    if d == None or type(d) != \"string\" or len(d) \u003c 10:\n        return None\n    y, m, day = d[0:4], d[5:7], d[8:10]\n    if y.isdigit() and m.isdigit() and day.isdigit() and d[4] == \"-\" and d[7] == \"-\":\n        return d[0:10]\n    return None\n\ndef _norm(raw, mode):\n    out = []\n    for e in raw or []:\n        title = e.get(\"title\")\n        if title == None or title.strip() == \"\":\n            continue                      # schema requires title; drop silently-empty rows\n        out.append({\n            \"version\": e.get(\"version\"),\n            \"date\": _valid_date(e.get(\"date\")),\n            \"title\": title.strip(),\n            \"highlights\": [h.strip() for h in e.get(\"highlights\", []) if h.strip() != \"\"][:8],\n            \"url\": e.get(\"url\"),\n            \"extracted_by\": mode,\n        })\n    return out\n\nentries = _norm(cached, \"cached_selectors\") if not drift else _norm(reasoned, \"reasoning_fallback\")\n\n# ISO date strings sort lexicographically; undated entries keep page order at the end.\ndated = sorted([e for e in entries if e[\"date\"] != None], key=lambda e: e[\"date\"], reverse=True)\nundated = [e for e in entries if e[\"date\"] == None]\nentries = dated + undated\n\nif since != None:\n    # BUGFIX (tap A2, 2026-07-13): an undated entry has no date to compare\n    # against `since`, so it cannot satisfy \"dated after `since`\" -- keeping\n    # it here contradicted this package's own contract test\n    # (since_filters_strictly_after expects entries.length == 1, i.e. only\n    # the dated entry after the cutoff, not the undated entry too).\n    entries = [e for e in entries if e[\"date\"] != None and e[\"date\"] \u003e since]\n\nentries = entries[:cap]\n\nresult = {\n    \"entries\": entries,\n    \"source\": {\"url\": page_url, \"checked_entries\": len(entries)},\n    \"extraction\": {\n        \"mode\": \"reasoning_fallback\" if drift else \"cached_selectors\",\n        \"drift_detected\": drift,\n        \"drift_reason\": drift_reason if drift else None,\n        \"repair_proposed\": drift,        # drift always opens a repair proposal (03 §6)\n    },\n}\n"
      },
      "effect_class": "read"
    },
    {
      "id": "__end__",
      "name": "end",
      "type": "end"
    }
  ],
  "edges": [
    {
      "from_node_id": "extract_fallback",
      "to_node_id": "normalize"
    },
    {
      "from_node_id": "extract_fallback__gate",
      "to_node_id": "extract_fallback",
      "condition_expression": "nodes.page.result.drift == true"
    },
    {
      "from_node_id": "extract_fallback__gate",
      "to_node_id": "extract_fallback__skip",
      "default_edge": true
    },
    {
      "from_node_id": "extract_fallback__skip",
      "to_node_id": "normalize"
    },
    {
      "from_node_id": "normalize",
      "to_node_id": "__end__"
    },
    {
      "from_node_id": "page",
      "to_node_id": "extract_fallback__gate"
    },
    {
      "from_node_id": "page",
      "to_node_id": "normalize"
    }
  ],
  "inputs": [
    {
      "name": "max_entries",
      "type": "int",
      "default_value": 25
    },
    {
      "name": "since",
      "type": "string",
      "description": "Return only entries dated after this; omit for the full first page"
    },
    {
      "name": "url",
      "type": "string",
      "description": "Changelog page URL; must be within the origin(s) bound to the watched_site slot",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "entries",
      "source_expression": "nodes.normalize.result.entries"
    },
    {
      "name": "extraction",
      "source_expression": "nodes.normalize.result.extraction"
    },
    {
      "name": "source",
      "source_expression": "nodes.normalize.result.source"
    }
  ],
  "metadata": {
    "compiled_by": "tap-compile",
    "effect_class": "read",
    "primitive_version": "0.1.0",
    "tap_api_version": "primitives.telara.dev/v1",
    "tap_source": "dev.telara/web-changelog-watch"
  }
}
