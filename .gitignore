# Built files and downloaded interpreters never go in git.
bin/
*.wasm
cache/
journal.jsonl

# The npm CLI entrypoint is source code, not a build artifact.
!npm/bin/
!npm/bin/tap.cjs

# Local environment and secret material
.env
.env.*
*.key
*.pem
id_rsa*
id_ed25519*
.DS_Store
dist/
*.key
.tmp/
.cache/

# Binaries go build leaves next to a command's package
/discover/discover-fixture
/discover/discover
/discover/discover-eval
